+/* ── gabbycat4 smooth motion: second core ─────────────────────────────────
+ * With decoupled presentation the guest's next field can run on a worker
+ * thread while this thread shows the current field's in-between pictures.
+ * The worker runs ONLY RtlRunFrame. Everything else (input, hooks, the PPU
+ * raster capture, the composed base picture, overlays, menus, save states)
+ * stays here and happens while the worker is idle:
+ *   field N:  join job N -> after_run_frame, capture, compose base picture
+ *             (not shown) -> start job N+1 with this field's input -> show
+ *             N's pictures through game->draw_inbetween (frozen data only).
+ * Cost: input reaches the guest one field later. Any event joins first. */
+#if SNESRECOMP_SDL3
+#define EMU_SEM SDL_Semaphore
+#define EMU_SEM_WAIT(s) SDL_WaitSemaphore(s)
+#define EMU_SEM_POST(s) SDL_SignalSemaphore(s)
+#define EMU_SEM_TRY(s) SDL_TryWaitSemaphore(s)
+#define EMU_EVENT_FIRST SDL_EVENT_FIRST
+#define EMU_EVENT_LAST SDL_EVENT_LAST
+#else
+#define EMU_SEM SDL_sem
+#define EMU_SEM_WAIT(s) SDL_SemWait(s)
+#define EMU_SEM_POST(s) SDL_SemPost(s)
+#define EMU_SEM_TRY(s) (SDL_SemTryWait(s) == 0)
+#define EMU_EVENT_FIRST SDL_FIRSTEVENT
+#define EMU_EVENT_LAST SDL_LASTEVENT
+#endif
+static struct {
+  SDL_Thread *thread;
+  EMU_SEM *go, *done;
+  int state;              /* 0 idle, 1 running, 2 finished but not yet used */
+  volatile int quit;
+  uint32 word;
+  bool audio;             /* the worker produces guest audio this job */
+  double seconds;         /* the last job's guest time (worker-written) */
+  unsigned long long jobs, waits;
+  double total, max, waited;
+  /* why the guest had to be idle early: queued event types (diagnostics) */
+  unsigned event_type[8];
+  unsigned long long event_joins[8], event_joins_other;
+  double event_waited;
+  unsigned long long deferrals;   /* loop passes that left events queued */
+} g_emu;
+
+static int SDLCALL EmuWorkerMain(void *unused) {
+  (void)unused;
+  if (g_game->pin_thread) g_game->pin_thread(1);   /* a core of its own */
+  for (;;) {
+    EMU_SEM_WAIT(g_emu.go);
+    if (g_emu.quit) break;
+    double t = MonotonicSeconds();
+    g_audio_producer_active = g_emu.audio;   /* thread-local: this thread */
+    RtlRunFrame(g_emu.word);
+    g_audio_producer_active = false;
+    g_emu.seconds = MonotonicSeconds() - t;
+    EMU_SEM_POST(g_emu.done);
+  }
+  return 0;
+}
+
+static bool EmuStart(uint32 word, bool audio) {
+  if (!g_emu.thread) {
+    if (!g_emu.go) g_emu.go = SDL_CreateSemaphore(0);
+    if (!g_emu.done) g_emu.done = SDL_CreateSemaphore(0);
+    if (!g_emu.go || !g_emu.done) return false;
+    if (g_game->pin_thread) g_game->pin_thread(0);   /* main: the guest's L3 group */
+    g_emu.thread = SDL_CreateThread(EmuWorkerMain, "guest", NULL);
+    if (!g_emu.thread) return false;
+    host_report_breadcrumb("second core: guest worker thread started");
+  }
+  g_emu.word = word;
+  g_emu.audio = audio;
+  g_emu.state = 1;
+  EMU_SEM_POST(g_emu.go);
+  return true;
+}
+
+static void EmuJoined(void) {
+  g_emu.state = 2;
+  ++g_emu.jobs;
+  g_emu.total += g_emu.seconds;
+  if (g_emu.seconds > g_emu.max) g_emu.max = g_emu.seconds;
+}
+
+static void EmuJoin(void) {
+  if (g_emu.state != 1) return;
+  if (!EMU_SEM_TRY(g_emu.done)) {
+    double t = MonotonicSeconds();
+    EMU_SEM_WAIT(g_emu.done);
+    g_emu.waited += MonotonicSeconds() - t;
+    ++g_emu.waits;
+  }
+  EmuJoined();
+}
+
+/* Join only if the guest has already finished; never waits. */
+static bool EmuTryJoin(void) {
+  if (g_emu.state != 1) return true;
+  if (!EMU_SEM_TRY(g_emu.done)) return false;
+  EmuJoined();
+  return true;
+}
+
+static bool EmuTake(void) {
+  EmuJoin();
+  if (g_emu.state != 2) return false;
+  g_emu.state = 0;
+  return true;
+}
+
+static void EmuDiscard(void) { EmuJoin(); g_emu.state = 0; }
+
+static void EmuStop(void) {
+  EmuDiscard();
+  if (g_emu.thread) {
+    g_emu.quit = 1;
+    EMU_SEM_POST(g_emu.go);
+    SDL_WaitThread(g_emu.thread, NULL);
+    g_emu.thread = NULL;
+  }
+  if (g_emu.jobs) {
+    fprintf(stderr, "[second-core] jobs=%llu guest_mean_ms=%.3f guest_max_ms=%.3f "
+            "joins_that_waited=%llu waited_ms=%.1f (of which for events %.1f)\n", g_emu.jobs,
+            1000.0 * g_emu.total / (double)g_emu.jobs, 1000.0 * g_emu.max,
+            g_emu.waits, 1000.0 * g_emu.waited, 1000.0 * g_emu.event_waited);
+    fprintf(stderr, "[second-core] event passes deferred until the guest was idle: %llu\n",
+            g_emu.deferrals);
+    for (int i = 0; i < 8 && g_emu.event_joins[i]; ++i)
+      fprintf(stderr, "[second-core] early joins for event type 0x%x: %llu\n",
+              g_emu.event_type[i], g_emu.event_joins[i]);
+    if (g_emu.event_joins_other)
+      fprintf(stderr, "[second-core] early joins for other event types: %llu\n", g_emu.event_joins_other);
+  }
+}
+
+/* Queued events that may touch the guest (keys, buttons, window, quit...).
+ * Pure motion/sensor events only update host input state: a pad's stick
+ * noise must not force the guest idle every picture. */
+static void EmuNoteEventJoin(unsigned type) {
+  for (int i = 0; i < 8; ++i) {
+    if (g_emu.event_type[i] == type || !g_emu.event_joins[i]) {
+      g_emu.event_type[i] = type; ++g_emu.event_joins[i]; return;
+    }
+  }
+  ++g_emu.event_joins_other;
+}
+
+/* A trigger crossing its press threshold becomes an L2/R2 button press
+ * (HandleGamepadAxisInput -> HandleGamepadInput: title hooks, commands).
+ * Stick motion and trigger wobble only update host input state. */
+static bool EmuTriggerChanges(const SDL_Event *e) {
+  GamepadInfo *gi;
+  int axis, value;
+  if (e->type == SDL_CONTROLLERAXISMOTION) {
+    gi = GetGamepadInfo(SNESRECOMP_SDL_EVENT_AXIS_DEVICE(*e));
+    axis = SNESRECOMP_SDL_EVENT_AXIS(*e);
+    value = SNESRECOMP_SDL_EVENT_AXIS_VALUE(*e);
+  } else {
+    gi = GetGamepadInfo(e->jaxis.which);
+    if (!gi || !gi->raw_joystick) return false;
+    axis = e->jaxis.axis;
+    value = e->jaxis.value;
+  }
+  if (!gi) return false;
+  if (axis != SDL_CONTROLLER_AXIS_TRIGGERLEFT && axis != SDL_CONTROLLER_AXIS_TRIGGERRIGHT) return false;
+  if (value >= 12000 && value < 16000) return false;   /* hysteresis band: ignored */
+  int button = axis == SDL_CONTROLLER_AXIS_TRIGGERLEFT ? kGamepadBtn_L2 : kGamepadBtn_R2;
+  return !!(gi->modifiers & (1u << button)) != (value >= 12000);
+}
+
+static bool EmuEventsNeedIdleGuest(void) {
+  SDL_Event ev[32];
+  SDL_PumpEvents();
+  int n = SDL_PeepEvents(ev, 32, SDL_PEEKEVENT, EMU_EVENT_FIRST, EMU_EVENT_LAST);
+  if (n >= 32) { EmuNoteEventJoin(0xFFFFu); return true; }
+  for (int i = 0; i < n; ++i) {
+    switch (ev[i].type) {
+#if SNESRECOMP_SDL3
+      case SDL_EVENT_JOYSTICK_AXIS_MOTION: case SDL_EVENT_GAMEPAD_AXIS_MOTION:
+        if (EmuTriggerChanges(&ev[i])) { EmuNoteEventJoin((unsigned)ev[i].type); return true; }
+        break;
+      case SDL_EVENT_MOUSE_MOTION:
+      case SDL_EVENT_JOYSTICK_BALL_MOTION: case SDL_EVENT_JOYSTICK_HAT_MOTION:
+      case SDL_EVENT_JOYSTICK_BATTERY_UPDATED: case SDL_EVENT_JOYSTICK_UPDATE_COMPLETE:
+      case SDL_EVENT_GAMEPAD_UPDATE_COMPLETE:
+      case SDL_EVENT_GAMEPAD_TOUCHPAD_MOTION: case SDL_EVENT_GAMEPAD_SENSOR_UPDATE:
+      case SDL_EVENT_SENSOR_UPDATE: case SDL_EVENT_FINGER_MOTION:
+      case SDL_EVENT_PEN_MOTION: case SDL_EVENT_PEN_AXIS: case SDL_EVENT_CLIPBOARD_UPDATE:
+#else
+      case SDL_JOYAXISMOTION: case SDL_CONTROLLERAXISMOTION:
+        if (EmuTriggerChanges(&ev[i])) { EmuNoteEventJoin((unsigned)ev[i].type); return true; }
+        break;
+      case SDL_MOUSEMOTION: case SDL_JOYBALLMOTION:
+      case SDL_JOYHATMOTION:
+      case SDL_CONTROLLERTOUCHPADMOTION: case SDL_CONTROLLERSENSORUPDATE:
+      case SDL_SENSORUPDATE: case SDL_FINGERMOTION:
+#endif
+        break;   /* host input state only: never touches the guest */
+      default:
+        EmuNoteEventJoin((unsigned)ev[i].type);
+        return true;
+    }
+  }
+  return false;
+}
+
+static bool EmuWanted(bool paced_custom) {
+  return paced_custom && g_game->emulation_thread && g_game->emulation_thread() &&
+         !g_turbo && !snes_runahead_active();
+}
+
+/* One picture while the guest may be running on the worker: the title draws
+ * an in-between picture from frozen data, or the last composed picture is
+ * shown again. Reads nothing the worker writes. */
+static void PresentInbetween(void) {
+  ProfileStamp profile_start = ProfileStart();
+  const int w = g_frozen_w, h = g_frozen_h;
+  if (w <= 0 || h <= 0) return;
+  uint8 *buffer = 0;
+  int pitch = 0;
+  g_renderer_funcs.BeginDraw(w, h, &buffer, &pitch);
+  ProfileEnd(kProfileAcquire, profile_start);
+  if (!buffer) { g_renderer_funcs.EndDraw(); return; }
+  profile_start = ProfileStart();
+  static uint8 inbetween[kSnesDesktopMaxFrameWidth * 480 * 4];
+  bool drawn = false;
+  /* The picture is the frame size, or double it (half-pixel pictures). */
+  const int doubled = w == 2 * g_snes_width && h == 2 * g_snes_height;
+  if (g_game->draw_inbetween && (doubled || (w == g_snes_width && h == g_snes_height)) &&
+      w <= kSnesDesktopMaxFrameWidth && h <= 480 &&
+      g_game->draw_inbetween(inbetween, (size_t)w * 4, g_my_pixels, w, h, g_present_alpha)) {
+    ComposeOsd(inbetween, w * 4, w, h, doubled ? 1 : 2);
+    for (int y = 0; y < h; ++y)
+      memcpy(buffer + (size_t)y * pitch, inbetween + (size_t)y * w * 4, (size_t)w * 4);
+    drawn = true;
+  }
+  if (!drawn)
+    for (int y = 0; y < h; ++y)
+      memcpy(buffer + (size_t)y * pitch, g_frozen_frame + (size_t)y * w * 4, (size_t)w * 4);
+  ProfileEnd(kProfileCompose, profile_start);
+  profile_start = ProfileStart();
+  g_renderer_funcs.EndDraw();
+  ProfileEnd(kProfilePresent, profile_start);
+  RecordFrameTiming(g_present_frame);
+}
